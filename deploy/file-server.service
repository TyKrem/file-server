[Unit]
Description=file-server (static file site with admin write access)
After=network-online.target

[Service]
Type=simple
User=root
Group=root
# 登录权限由统一会话校验，文件目录和配额在本单元配置。
EnvironmentFile=/etc/auth-session.env
Environment=FILE_HOST=127.0.0.1
Environment=FILE_PORT=8801
Environment=FILE_ROOT=/opt/file-server/root
Environment=FILE_MAX_BYTES=21474836480
ExecStart=/opt/file-server/file-server
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
